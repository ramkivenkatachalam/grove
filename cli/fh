def service_urls(f: dict) -> str:
    return ", ".join(f"{svc} http://localhost:{port}" for svc, port in ports(f).items())


def write_brief(p: dict, f: dict, ticket: str | None, prompt: str | None) -> None:
    head = []
    if ticket:
        head.append(f"# {ticket}\n\nFetch issue {ticket} with your tracker's tools (for Linear: get_issue, "
                    "list_comments) and read its description and comments before you start.")
    if prompt:
        head.append(("" if ticket else "# Task\n\n") + prompt)
    servers = ""
    if ports(f):
        servers = (f"Its services already run in panels beside you: {service_urls(f)}. Use exactly these ports "
                   f"for curl and browser checks — never the project's defaults or another worktree's. "
                   f"If a service is down, run `fh restart {f['name']}`.")
    notes = f"\n{p['agentNotes']}" if p.get("agentNotes") else ""
    body = f"""
## How this run works
You are working alone in worktree `{f['path']}` on branch `{f['branch']}`. {servers}{notes}

## Finish like this
- Keep to the task's scope. {p.get('checks') or DEFAULT_PROJECT['checks']}
- Commit with a conventional message describing what the code does, push, and open a draft PR,
  then invoke the `pr-watch-feedback` skill (if you have it) to see CI and review findings through.
- End with a 3-line summary: what changed, what you verified, what you did not.
"""
    (BRIEFS / f"{f['name']}.md").write_text("\n\n".join(head) + "\n" + body)


# ---------- commands ----------

def cmd_new(args: list[str]) -> None:
    prompt = base = title = parent = proj = None
    rest = []
    it = iter(args)
    for a in it:
        if a in ("-p", "--prompt"):
            prompt = " ".join(it) or None  # the rest of the line, quoted or not
        elif a == "--base":
            base = next(it, None)
        elif a == "--title":
            title = next(it, None)
        elif a == "--parent":
            parent = next(it, None)
        elif a == "--project":
            proj = next(it, None)
        else:
            rest.append(a)
    if not rest:
        die("fh new <name|TICKET-123> [--project P] [--title T] [--parent NAME] [--base REF] [-p PROMPT]")
    if parent and not proj and (REG / f"{parent}.json").exists():
        proj = feature(parent).get("project")
    p = project(proj or project_here() or default_project())
    arg = rest[0]
    ticket = arg.upper() if TICKET.match(arg) else None
    name = arg.lower()
    if not re.match(r"^[a-z0-9][a-z0-9._-]{0,40}$", name):
        die("name must be lowercase letters, digits, . _ -")
    if (REG / f"{name}.json").exists():
        die(f"feature '{name}' exists")
    repo = p["repo"]
    if run(["git", "-C", str(repo), "rev-parse", "--git-dir"]).returncode:
        die(f"{repo} is not a git repository (project {p['name']})")
    wt = p["worktrees"] / name
    branch = p["branchPrefix"].replace("{user}", handle(p)) + name
    run(["git", "-C", str(repo), "fetch", "-q", "--prune", "origin"])
    if wt.exists():
        if run(["git", "-C", str(wt), "rev-parse", "--git-dir"]).returncode:
            die(f"{wt} exists and is not a worktree")
        branch = run(["git", "-C", str(wt), "branch", "--show-current"]).stdout.strip()
    elif run(["git", "-C", str(repo), "show-ref", "-q", "--verify", f"refs/heads/{branch}"]).returncode == 0:
        run(["git", "-C", str(repo), "worktree", "add", "-q", str(wt), branch], check=True)
    else:
        start = base or p["base"]
        if run(["git", "-C", str(repo), "rev-parse", "-q", "--verify", start]).returncode:
            start = "HEAD"  # a repo without that ref (no remote yet)
        run(["git", "-C", str(repo), "worktree", "add", "-q", "-b", branch, str(wt), start], check=True)
    taken = listening() | {port for other in features() for port in ports(other).values()}
    assigned = {}
    for s in services(p):
        assigned[s["name"]] = alloc(s, taken | set(assigned.values()))
    f = {"name": name, "project": p["name"], "path": str(wt), "branch": branch, "ports": assigned,
         "ticket": ticket, "createdAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    f["links"] = {s["name"]: fill(s["open"], f, assigned[s["name"]]) for s in services(p) if s.get("open")}
    if p.get("agentNotes"):
        f["agentNotes"] = p["agentNotes"]
    if title:
        f["title"] = title
    if parent:
        f["parent"] = parent
    provision(p, f)
    write_json(REG / f"{name}.json", f)
    if ticket or prompt:
        write_brief(p, f, ticket, prompt)
    open_window(f)
    write_json(HUB / "focus.json", {"name": name, "at": time.time()})  # the app switches to it
    print(f"{name}: {wt} [{branch}]  {service_urls(f) or 'no services'}" + ("  (agent briefed)" if ticket or prompt else ""))


def cmd_adopt(args: list[str]) -> None:
    """Register an existing worktree as a feature: nothing new is created; it gets its own ports, its
    env rewritten, and sessions with services stopped (start them with fh up). With --session <id>,
    bring in a Claude conversation from the main checkout instead."""
    if "--session" in args:
        i = args.index("--session")
        title = args[args.index("--title") + 1] if "--title" in args else None
        for sid in [a for a in args[i + 1:] if re.match(r"^[0-9a-f-]{36}$", a)]:
            adopt_session(sid, title)
        return
    title = proj = name = None
    paths = []
    it = iter(args)
    for a in it:
        if a == "--title":
            title = next(it, None)
        elif a == "--project":
            proj = next(it, None)
        elif a == "--name":
            name = next(it, None)
        else:
            paths.append(a)
    if not paths:
        die("adopt <worktree path>… [--name N] [--title T] [--project P]")
    for raw in paths:
        wt = expand(raw)
        if run(["git", "-C", str(wt), "rev-parse", "--git-dir"]).returncode:
            print(f"fh: {wt} is not a git worktree", file=sys.stderr)
            continue
        common = expand(run(["git", "-C", str(wt), "rev-parse", "--path-format=absolute", "--git-common-dir"]).stdout.strip())
        p = project(proj) if proj else next(
            (project(n) for n in project_names() if (project(n)["repo"] / ".git").resolve() == common), None)
        if p is None:
            print(f"fh: {wt} belongs to no registered project (fh project add <its main checkout>)", file=sys.stderr)
            continue
        if any(f["path"] == str(wt) for f in features()):
            print(f"{wt}: already a feature")
            continue
        branch = run(["git", "-C", str(wt), "branch", "--show-current"]).stdout.strip()
        tail = branch.split("/")[-1] or wt.name
        fname = (name if name and len(paths) == 1 else re.sub(r"[^a-z0-9._-]+", "-", tail.lower()))[:40].strip("-.")
        if (REG / f"{fname}.json").exists():
            fname = f"{fname[:36]}-{wt.name[-3:]}"
        m = re.match(r"^([a-z][a-z0-9]*-\d+)", fname)
        pr_title = run(["gh", "pr", "list", "--head", branch, "--state", "all", "--limit", "1", "--json", "title",
                        "--jq", ".[0].title // \"\""], cwd=p["repo"]).stdout.strip() if branch else ""
        taken = listening() | {port for other in features() for port in ports(other).values()}
        assigned = {}
        for svc in services(p):
            assigned[svc["name"]] = alloc(svc, taken | set(assigned.values()))
        f = {"name": fname, "project": p["name"], "path": str(wt), "branch": branch, "ports": assigned,
             "ticket": m.group(1).upper() if m else None,
             "title": title if title and len(paths) == 1 else tidy_title(pr_title) or tail.replace("-", " ").strip().capitalize(),
             "adopted": True, "createdAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
        f["links"] = {svc["name"]: fill(svc["open"], f, assigned[svc["name"]]) for svc in services(p) if svc.get("open")}
        if p.get("agentNotes"):
            f["agentNotes"] = p["agentNotes"]
        provision(p, f)
        write_json(REG / f"{fname}.json", f)
        open_window(f, servers=False)
        print(f"{fname}: adopted {wt} [{branch}] “{f['title']}”  {service_urls(f)} (services stopped: fh up {fname})")


TRANSCRIPTS = HOME / ".claude/projects"


def mangle(path: str) -> str:
    return re.sub(r"[^A-Za-z0-9]", "-", path)


def transcript_info(path: Path) -> dict:
    """id, folder, branch and title of a Claude Code transcript (its first cwd, its last aiTitle)."""
    info = {"id": path.stem, "cwd": "", "branch": "", "title": "", "mtime": path.stat().st_mtime}
    try:
        with path.open() as fh_:
            for line in fh_:
                if not info["cwd"] and '"cwd":"' in line:
                    info["cwd"] = re.search(r'"cwd":"([^"]*)"', line).group(1)
                    m = re.search(r'"gitBranch":"([^"]*)"', line)
                    info["branch"] = m.group(1) if m else ""
                if '"aiTitle":"' in line:
                    info["title"] = re.search(r'"aiTitle":"([^"]*)"', line).group(1)
    except OSError:
        pass
    return info


def recent_sessions(p: dict, hours: float) -> list[dict]:
    """Claude conversations in the project's main checkout (or below it) touched in the last `hours`,
    leaving out feature worktrees and sessions already in Grove."""
    repo = str(p["repo"])
    taken = {f.get("session") for f in features()}
    worktrees = [f["path"] for f in features() if f.get("kind") != "session"]
    cutoff = time.time() - hours * 3600
    found = []
    for folder in TRANSCRIPTS.glob(mangle(repo) + "*"):
        for t in folder.glob("*.jsonl"):
            if t.stat().st_mtime < cutoff or t.stem in taken:
                continue
            info = transcript_info(t)
            cwd = info["cwd"]
            if not (cwd == repo or cwd.startswith(repo + "/")) or any(cwd == w or cwd.startswith(w + "/") for w in worktrees):
                continue
            found.append(info)
    return sorted(found, key=lambda i: -i["mtime"])


def adopt_session(sid: str, title: str | None) -> None:
    path = next(TRANSCRIPTS.glob(f"*/{sid}.jsonl"), None)
    if path is None:
        die(f"no Claude conversation {sid} under {TRANSCRIPTS}")
    info = transcript_info(path)
    p = next((project(n) for n in project_names()
              if info["cwd"] == str(project(n)["repo"]) or info["cwd"].startswith(str(project(n)["repo"]) + "/")), None)
    if p is None:
        die(f"{info['cwd']} is in no registered project")
    name = f"s-{sid[:8]}"
    if (REG / f"{name}.json").exists():
        print(f"{name}: already in Grove")
        return
    f = {"name": name, "kind": "session", "session": sid, "project": p["name"], "path": info["cwd"],
         "branch": info["branch"] or run(["git", "-C", info["cwd"], "branch", "--show-current"]).stdout.strip(),
         "ports": {}, "title": title or info["title"] or f"Session {sid[:8]}", "confirmResume": True,
         "createdAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    write_json(REG / f"{name}.json", f)
    open_window(f)
    rel = info["cwd"][len(str(p["repo"])):].lstrip("/") or "main checkout"
    print(f"{name}: “{f['title']}” ({rel}) — type /exit in its old terminal, then press Enter in its Grove panel")


def cmd_sessions(args: list[str]) -> None:
    hours = float(args[args.index("--hours") + 1]) if "--hours" in args else 24
    p = project(args[args.index("--project") + 1] if "--project" in args else project_here() or default_project())
    rows = recent_sessions(p, hours)
    if not rows:
        print(f"no Claude conversations in {p['repo']} in the last {hours:g}h outside feature worktrees")
    for i in rows:
        rel = i["cwd"][len(str(p["repo"])):].lstrip("/") or "."
        age = time.strftime("%m-%d %H:%M", time.localtime(i["mtime"]))
        print(f"{i['id']}  {age}  {rel:<14} {i['title'] or '(untitled)'}")


def tidy_title(text: str) -> str:
    """A PR title as a sidebar title: no conventional-commit prefix, no trailing ticket."""
    text = re.sub(r"^\w+(\([^)]*\))?!?:\s*", "", text.strip())
    text = re.sub(r"\s*\(([A-Z][A-Z0-9]*-\d+)\)\s*$", "", text)
    return text[:1].upper() + text[1:]


def claude_running_in(path: str) -> list[str]:
    """Claude processes whose working directory is this worktree (or below), outside Grove's sessions."""
    found = []
    for pid in run(["pgrep", "-x", "claude"]).stdout.split():
        cwd = next((ln[1:] for ln in run(["lsof", "-a", "-p", pid, "-d", "cwd", "-Fn"]).stdout.splitlines()
                    if ln.startswith("n")), "")
        if cwd == path or cwd.startswith(path + "/"):
            tty = run(["ps", "-o", "tty=", "-p", pid]).stdout.strip()
            found.append(f"pid {pid} ({tty})")
    return found


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, ValueError):
        return False
    except PermissionError:
        return True


def awake_pid() -> int | None:
    """The running keep-awake watcher, if there is one."""
    try:
        pid = int(AWAKE.read_text().strip())
    except (OSError, ValueError):
        return None
    return pid if pid_alive(pid) else None


def agents_working() -> list[str]:
    """Features whose session says it is working and whose Claude is still running (a state left
    behind by a crash or a reboot does not count)."""
    return [f["name"] for f in features()
            if read_json(STATUS / f"{f['name']}.json", {}).get("state") == "working"
            and claude_running_in(f["path"])]


def keepawake_loop() -> None:
    """Hold a `caffeinate` while any agent works; exit once none do. It dies with this process (-w)."""
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    AWAKE.write_text(str(os.getpid()))
    hold = None
    try:
        while True:
            if read_json(CONFIG, {}).get("keepAwake", True) and agents_working():
                if hold is None or hold.poll() is not None:
                    # -i: no idle sleep; -s: no system sleep while on power; -m: disks stay up
                    hold = subprocess.Popen(["caffeinate", "-ims", "-w", str(os.getpid())])
                time.sleep(AWAKE_POLL)
                continue
            # let go, then look once more: a session may have started work as the pid file went
            AWAKE.unlink(missing_ok=True)
            if read_json(CONFIG, {}).get("keepAwake", True) and agents_working():
                AWAKE.write_text(str(os.getpid()))
                continue
            return
    finally:
        if hold is not None and hold.poll() is None:
            hold.terminate()
        if awake_pid() in (None, os.getpid()):
            AWAKE.unlink(missing_ok=True)


def cmd_keepawake(args: list[str]) -> None:
    cfg = read_json(CONFIG, {})
    if args[:1] in (["on"], ["off"]):
        cfg["keepAwake"] = args[0] == "on"
        write_json(CONFIG, cfg)
    if "--run" in args:
        keepawake_loop()
        return
    on = cfg.get("keepAwake", True)
    pid = awake_pid()
    if on and pid is None and "--status" not in args and sys.platform == "darwin" and agents_working():
        pid = subprocess.Popen([sys.executable, os.path.abspath(__file__), "keepawake", "--run"],
                               stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                               start_new_session=True).pid
    if pid is not None and not on:
        os.kill(pid, signal.SIGTERM)
        pid = None
    working = agents_working()
    state = "off" if not on else f"holding the Mac awake for {', '.join(working)}" if pid and working else "idle"
    print(f"keepawake: {state}")


def cmd_agent(name: str) -> None:
    f = feature(name)
    os.chdir(f["path"])
    if f.get("kind") == "session":
        if f.get("confirmResume"):
            print(f"“{f['title']}” moves here from where it was running.")
            print("First type /exit in its old terminal tab (two live copies of one conversation would")
            print("interleave), then press Enter here to resume it.  Ctrl-C leaves this panel as a shell.")
            try:
                input()
            except (EOFError, KeyboardInterrupt):
                os.execvp(os.environ.get("SHELL", "zsh"), [os.environ.get("SHELL", "zsh")])
            f.pop("confirmResume", None)
            write_json(REG / f"{name}.json", f)
        os.execvp("claude", ["claude", "--resume", f["session"]])
    others = claude_running_in(f["path"])
    if others:
        print(f"Claude is already running in this worktree in another terminal: {', '.join(others)}.")
        print("Two sessions on one worktree would trip over each other. Exit that one, then press Enter")
        print("here to continue its conversation in Grove (or Ctrl-C to leave this panel as a shell).")
        try:
            input()
        except (EOFError, KeyboardInterrupt):
            os.execvp(os.environ.get("SHELL", "zsh"), [os.environ.get("SHELL", "zsh")])
    brief = BRIEFS / f"{name}.md"
    if brief.exists():
        text = brief.read_text()
        brief.rename(brief.with_suffix(".sent.md"))
        os.execvp("claude", ["claude", text])
    transcripts = HOME / ".claude/projects" / re.sub(r"[^A-Za-z0-9]", "-", f["path"])
    if any(transcripts.glob("*.jsonl")):
        os.execvp("claude", ["claude", "--continue"])
    os.execvp("claude", ["claude"])


def cmd_serve(svc: str, name: str) -> None:
    f = feature(name)
    service = next((s for s in services(project_of(f)) if s["name"] == svc), None)
    if service is None:
        die(f"no service '{svc}' in project {f.get('project')}")
    port = ports(f).get(svc)
    if port:
        stop_port(port)
    os.chdir(Path(f["path"]) / service.get("dir", ""))
    os.execvp("bash", ["bash", "-c", fill(service["run"], f, port)])


def cmd_servers(name: str, up: bool) -> None:
    f = feature(name)
    ensure_session()
    if ui_mode() == "app":
        host(f)
    elif not has_window(name):
        open_window(f, servers=up)
        print(f"{name}: window opened, services {'starting' if up else 'stopped'}")
        return
    if not up:
        for port in ports(f).values():
            stop_port(port)
    for pane in layout(f):
        if pane.get("service") and (pid := find_pane(name, pane["name"])):
            tmux("respawn-pane", "-k", "-t", pid, "-c", str(Path(f["path"]) / pane.get("dir", "")), pane_run(pane, f, up))
    print(f"{name}: services {'restarting' if up else 'stopped'}")


def cmd_ls() -> None:
    regs = features()
    if not regs:
        print("(no features — fh new <name|TICKET-123>)")
        return
    live = listening()
    pr_sync()
    print(f"{'FEATURE':<22} {'PROJECT':<12} {'SERVICES':<24} {'LABELS':<14} {'PR':<15} {'STATE':<8} WORK → NEXT")
    for f in regs:
        status = read_json(STATUS / f"{f['name']}.json", {})
        work = " → ".join(x for x in (status.get("work"), status.get("next")) if x) or "-"
        svcs = " ".join(f"{s}:{port}{'●' if port in live else '○'}" for s, port in ports(f).items()) or "-"
        try:
            labs = " ".join(f"{n}:{v}" for n, v in labels(project_of(f), f)) or "-"
        except SystemExit:
            labs = "?"
        pr = pr_for(f)
        prs = "-"
        if pr:
            mark = {"pass": "✓", "fail": "✗", "running": "⟳", "none": ""}[pr["ci"]]
            prs = f"#{pr['number']} {pr['state'].lower()}{' ' + mark if pr['state'] == 'OPEN' else ''}"
            if pr.get("findings"):
                prs += f" 💬{pr['findings']}"
        print(f"{f['name']:<22} {f.get('project', '?'):<12} {svcs:<24} {labs:<14} {prs:<15} "
              f"{status.get('state', '-'):<8} {work[:60]}")


def cmd_findings(name: str, brief: bool, mark: bool) -> None:
    f = feature(name)
    p = project_of(f)
    pr = pr_for(f) or pr_sync(force=True).get("byBranch", {}).get(f["branch"])
    if not pr:
        die(f"{name}: no PR for {f['branch']}")
    pending = new_findings(p, pr["number"], pr["updatedAt"], refresh=True)
    if not pending:
        print(f"{name}: no unanswered review-bot findings on #{pr['number']}")
        return
    if brief:
        lines = [f"The review bots left {len(pending)} comment(s) on PR #{pr['number']} that nobody has answered yet."]
        for i, c in enumerate(pending, 1):
            title = c["body"].strip().splitlines()[0][:120] if c["body"].strip() else "(no text)"
            lines += [f"{i}. [{severity(c['body'])}] {title}", f"   {c['path']}:{c['line']}   {c['url']}",
                      "   " + c["body"].replace("\n", "\n   ")]
        lines += ["For each one:",
                  "- Read the code first. If the finding is wrong, say so in a reply and leave the code alone — a rebuttal is a valid outcome.",
                  "- If it is right, fix it properly rather than to the letter of the suggested patch.",
                  "- Reply on the thread saying what you did (`gh api repos/:owner/:repo/pulls/comments/<id>/replies -f body=...`).",
                  "- Re-run the checks that cover what you touched, then commit and push.",
                  "- Do not touch anything the comments did not raise."]
        print("\n".join(lines))
    else:
        for c in pending:
            print(f"[{severity(c['body'])}] {c['path']}:{c['line']}  {c['url']}")
    if mark:
        new_findings(p, pr["number"], pr["updatedAt"], mark=True)


def merged_and_clean(f: dict) -> str | None:
    pr = pr_for(f)
    if not pr or pr["state"] != "MERGED":
        return None
    if run(["git", "-C", f["path"], "status", "--porcelain"]).stdout.strip():
        return None
    return f"#{pr['number']} merged"


def cmd_done(name: str, remove: bool = False) -> None:
    f = feature(name)
    panes = layout(f) if f.get("project") or project_names() else []
    for port in ports(f).values():
        stop_port(port)
    for path in (REG / f"{name}.json", STATUS / f"{name}.json", BRIEFS / f"{name}.md"):
        path.unlink(missing_ok=True)
    if remove:
        repo = project_of(f)["repo"]
        r = run(["git", "-C", str(repo), "worktree", "remove", f["path"]])
        print(f"{name}: closed and worktree removed" if r.returncode == 0 else f"{name}: closed; {r.stderr.strip()}")
    else:
        print(f"{name}: closed. Worktree kept at {f['path']}")
    for row in owned_panes(name):
        if row["session"] == PARK:
            tmux("kill-pane", "-t", row["id"])
    for pane in panes:
        tmux("kill-session", "-t", f"={host_session(name, pane['name'])}")
    # last: run from inside this feature's own window, killing it ends this process too
    tmux("kill-window", "-t", f"{SESSION}:{name}")


def cmd_clean(yes: bool) -> None:
    pr_sync(force=True)
    done = [(f, why) for f in features() if (why := merged_and_clean(f))]
    if not done:
        print("nothing to clean: no feature has a merged PR and a clean tree")
        return
    for f, why in done:
        if yes:
            cmd_done(f["name"], remove=True)
        else:
            print(f"{f['name']:<26} {why}  — fh clean --yes removes it (branch kept)")


def cmd_doctor() -> None:
    problems = 0

    def warn(msg: str) -> None:
        nonlocal problems
        problems += 1
        print(f"  ✗ {msg}")

    print("tools")
    for tool, fix in (("tmux", "brew install tmux"), ("gh", "brew install gh"), ("claude", ""), ("git", "")):
        if run(["which", tool]).returncode:
            warn(f"{tool} missing {fix}")
    for name in project_names():
        p = project(name)
        print(f"project {name}  ({p['repo']})")
        if run(["git", "-C", str(p["repo"]), "rev-parse", "--git-dir"]).returncode:
            warn("repo is not a git repository")
        for rel in p["setup"].get("link", []) + p["setup"].get("clone", []) + p["setup"].get("copy", []):
            if not (p["repo"] / rel).exists():
                warn(f"{rel} is missing in the main checkout (setup cannot provide it)")
    live = listening()
    regs = features()
    for f in regs:
        wt = Path(f["path"])
        print(f["name"])
        if not wt.exists():
            warn(f"worktree {wt} is gone — fh done {f['name']}")
            continue
        if f.get("kind") == "session":
            continue
        try:
            p = project_of(f)
        except SystemExit:
            warn(f"its project '{f.get('project')}' is not registered")
            continue
        for rel in p["setup"].get("copy", []) + p["setup"].get("link", []):
            if not (wt / rel).exists():
                warn(f"{rel} missing")
        for rel in p["setup"].get("clone", []):
            if not (wt / rel).exists():
                warn(f"{rel} missing")
            elif (wt / rel).is_symlink():
                warn(f"{rel} is a symlink, expected a copy: rm it and `cp -Rc` it from the main checkout")
        for s in services(p):
            port = ports(f).get(s["name"])
            lo, hi = (s.get("ports") or [0, 65535])[:2]
            if port is None:
                warn(f"no port assigned for {s['name']}")
            elif not lo <= port <= hi:
                warn(f"{s['name']} port {port} is outside {lo}-{hi}")
        for rule in p.get("env", []):
            path = wt / rule["file"]
            text = path.read_text() if path.exists() else ""
            for key, svc in rule.get("port", {}).items():
                port = ports(f).get(svc)
                line = next((ln for ln in text.splitlines() if ln.startswith(f"{key}=")), "")
                if port and line and f"localhost:{port}" not in line:
                    warn(f"{rule['file']} {key} does not point at {svc} :{port}")
            for key, value in rule.get("set", {}).items():
                if f"{key}={fill(value, f)}" not in text:
                    warn(f"{rule['file']} {key} is not {fill(value, f)}")
        for (lab_name, value), rule in zip(labels(p, f), p.get("labels", [])):
            if value in rule.get("warn", []) or value == "none" and rule.get("required"):
                warn(f"{lab_name} is {value}")
        mine = set(ports(f).values())
        for other in regs:
            if other is not f and set(ports(other).values()) & mine:
                warn(f"shares a port with {other['name']}")
        if (mine & live) and not owned_panes(f["name"]):
            warn("its ports are served by something outside Grove")
    print(f"\n{problems} problem(s)" if problems else "\nall good")


def detect_services(repo: Path) -> list[dict]:
    """A starter guess for `fh project add`: a JS dev server and/or a Python web app."""
    found = []
    for pkg in [repo / "package.json", *sorted(repo.glob("*/package.json"))][:6]:
        scripts = read_json(pkg, {}).get("scripts", {})
        if "dev" in scripts:
            rel = "" if pkg.parent == repo else pkg.parent.name
            name = "web" if not found else (rel or "web2")
            found.append({"name": name, "dir": rel, "run": "exec npm run dev -- --port {port}",
                          "ports": [3001, 3099], "reserved": [3000], "open": "http://localhost:{port}"})
            break
    for marker, cmd in (("manage.py", "exec python manage.py runserver {port}"),
                        ("main.py", "exec python -m uvicorn main:app --reload --port {port}")):
        for path in [repo / marker, *sorted(repo.glob(f"*/{marker}"))][:6]:
            if path.exists():
                rel = "" if path.parent == repo else path.parent.name
                found.append({"name": "api", "dir": rel, "run": cmd, "ports": [8001, 8099], "reserved": [8000]})
                break
        if any(s["name"] == "api" for s in found):
            break
    return found


def cmd_project(rest: list[str]) -> None:
    sub = rest[0] if rest else "ls"
    if sub == "ls":
        default = read_json(CONFIG, {}).get("defaultProject")
        for name in project_names():
            p = project(name)
            print(f"{'*' if name == default else ' '} {name:<16} {p['repo']}  services: "
                  f"{', '.join(s['name'] for s in services(p)) or '-'}")
        if not project_names():
            print("(no projects — fh project add <repo>)")
    elif sub == "add":
        if len(rest) < 2:
            die("project add <repo> [--name N]")
        repo = expand(rest[1])
        if run(["git", "-C", str(repo), "rev-parse", "--git-dir"]).returncode:
            die(f"{repo} is not a git repository")
        name = rest[rest.index("--name") + 1] if "--name" in rest else repo.name.lower()
        if (PROJECTS / f"{name}.json").exists():
            die(f"project '{name}' exists (fh project show {name})")
        mine = {"repo": str(repo).replace(str(HOME), "~")}
        if not (repo / ".grove.json").exists():
            mine["services"] = detect_services(repo)
            mine["_help"] = ("Grove project config — see `fh` docs: services, setup, env, labels, checks, agentNotes. "
                             "Commit a .grove.json to the repo to share it; keys here override it.")
        write_json(PROJECTS / f"{name}.json", mine)
        cfg = read_json(CONFIG, {})
        if not cfg.get("defaultProject"):
            cfg["defaultProject"] = name
            write_json(CONFIG, cfg)
        print(f"project {name}: {repo} ({'.grove.json' if (repo / '.grove.json').exists() else 'starter config'}) "
              f"→ edit {PROJECTS / (name + '.json')}")
    elif sub == "default":
        if len(rest) < 2 or rest[1] not in project_names():
            die(f"project default <name> (projects: {', '.join(project_names())})")
        cfg = read_json(CONFIG, {})
        cfg["defaultProject"] = rest[1]
        write_json(CONFIG, cfg)
        print(f"default project: {rest[1]}")
    elif sub == "show":
        p = project(rest[1] if len(rest) > 1 else default_project())
        print(json.dumps({k: str(v) if isinstance(v, Path) else v for k, v in p.items()}, indent=2))
    else:
        die("project ls | add <repo> [--name N] | default <name> | show [name]")


def cmd_statusline() -> None:
    """Claude Code's status line: in the tmux UI the feature switcher; in the app nothing (the sidebar
    is the switcher); outside features an optional legacy script."""
    raw = sys.stdin.read()
    data = parse_json(raw)
    cwd = (data.get("workspace") or {}).get("current_dir") or data.get("cwd") or os.getcwd()
    regs = features()
    sid = data.get("session_id")
    here = next((f for f in regs if (f.get("session") == sid if f.get("kind") == "session"
                                     else cwd == f["path"] or cwd.startswith(f["path"] + "/"))), None)
    legacy = HOME / ".claude/statusline-feature.sh"
    if here is not None and ui_mode() == "app":
        # the app's sidebar is the switcher: only what it doesn't show (and never empty, so Claude
        # replaces whatever it showed before)
        model = (data.get("model") or {}).get("display_name") or ""
        cost = (data.get("cost") or {}).get("total_cost_usd")
        bits = [model, f"${cost:.2f}" if isinstance(cost, (int, float)) else ""]
        print("\033[38;5;245m" + (" · ".join(b for b in bits if b) or " ") + "\033[0m")
        return
    if here is None or not os.environ.get("TMUX"):
        if legacy.exists():
            os.execvp("bash", ["bash", "-c", f"printf '%s' {shlex.quote(raw)} | {shlex.quote(str(legacy))}"])
        return
    index = {}
    for line in tmux("list-windows", "-t", SESSION, "-F", "#I\t#W").stdout.splitlines():
        i, _, w = line.partition("\t")
        index[w] = i
    pal = theme()

    def fg(hexcolour: str) -> str:
        h = hexcolour.lstrip("#")
        return "\033[38;2;{};{};{}m".format(*(int(h[i:i + 2], 16) for i in (0, 2, 4)))

    def bg(hexcolour: str) -> str:
        h = hexcolour.lstrip("#")
        return "\033[48;2;{};{};{}m".format(*(int(h[i:i + 2], 16) for i in (0, 2, 4)))

    look = {"waiting": ("❗", "needs you", pal["waiting"]), "ready": ("✓", "your turn", pal["ready"]),
            "working": ("⏳", "working", pal["working"]), "offline": ("·", "offline", "#a8a8a8")}
    parts = []
    for f in regs:
        st = read_json(STATUS / f"{f['name']}.json", {}).get("state", "offline")
        glyph, word, colour = look.get(st, look["offline"])
        num = index.get(f["name"], "?")
        if f is here:
            parts.append(f"{bg(pal['name'])}\033[1;30m ▶ {num} {f['name']} \033[0m")
        else:
            label = f" {word}" if st in ("waiting", "ready") else ""
            parts.append(f"{fg(colour)}{num} {glyph} {f['name']}{label}\033[0m")
    print("  ".join(parts) + f"   {fg('#a8a8a8')}^b n switch · ^b F pick · ^b N new\033[0m")


def parse_json(text: str) -> dict:
    try:
        value = json.loads(text)
        return value if isinstance(value, dict) else {}
    except ValueError:
        return {}


def main(argv: list[str]) -> None:
    cmd, rest = (argv[0], argv[1:]) if argv else ("ls", [])

    def need(n: int, usage: str) -> None:
        if len(rest) < n:
            die(usage)

    if cmd == "new":
        cmd_new(rest)
    elif cmd == "project":
        cmd_project(rest)
    elif cmd == "adopt":
        cmd_adopt(rest)
    elif cmd == "sessions":
        cmd_sessions(rest)
    elif cmd == "go":
        need(1, "go <name>")
        f = feature(rest[0])
        open_window(f)
        switch_to(f["name"])
    elif cmd == "ls":
        cmd_ls()
    elif cmd == "agent":
        need(1, "agent <name>")
        cmd_agent(rest[0])
    elif cmd == "serve":
        need(2, "serve <service> <name>")
        cmd_serve(rest[0], rest[1])
    elif cmd in ("up", "restart"):
        need(1, f"{cmd} <name>")
        cmd_servers(rest[0], up=True)
    elif cmd == "down":
        need(1, "down <name>")
        cmd_servers(rest[0], up=False)
    elif cmd == "pr":
        cache = pr_sync(force="--force" in rest)
        print(f"{len(cache.get('byBranch', {}))} PRs cached")
    elif cmd == "findings":
        need(1, "findings <name> [--brief] [--mark]")
        cmd_findings(rest[0], "--brief" in rest, "--mark" in rest)
    elif cmd == "clean":
        cmd_clean("--yes" in rest)
    elif cmd == "done":
        need(1, "done <name>")
        cmd_done(rest[0])
    elif cmd == "host":
        need(1, "host <name>")
        print(json.dumps(host(feature(rest[0]))))
    elif cmd == "rename":
        need(2, "rename <name> <title…>")
        f = feature(rest[0])
        f["title"] = " ".join(rest[1:]).strip() or f["name"]
        write_json(REG / f"{f['name']}.json", f)
        print(f"{f['name']}: titled “{f['title']}”")
    elif cmd == "ui":
        cfg = read_json(CONFIG, {})
        if rest:
            if rest[0] not in ("app", "tmux"):
                die("ui app|tmux")
            cfg["ui"] = rest[0]
            write_json(CONFIG, cfg)
        print(f"ui: {cfg.get('ui', 'tmux')}")
    elif cmd == "theme":
        t = read_json(THEME, DEFAULT_THEME) if THEME.exists() else DEFAULT_THEME
        if not rest:
            print(f"palette: {t.get('palette')}  (choices: {', '.join(t.get('palettes', {}))})")
        elif rest[0] not in t.get("palettes", {}):
            die(f"no palette '{rest[0]}' (choices: {', '.join(t.get('palettes', {}))})")
        else:
            write_json(THEME, {**t, "palette": rest[0]})
            apply_theme()
            for f in features():
                if has_window(f["name"]):
                    paint_buttons(f)
            print(f"palette: {rest[0]} (headers repaint within a few seconds)")
    elif cmd == "statusline":
        cmd_statusline()
    elif cmd == "toggle":
        need(2, "toggle <name> <panel>")
        toggle(feature(rest[0]), rest[1])
    elif cmd == "relayout":
        need(1, "relayout <name>")
        f = feature(rest[0])
        old = f"{SESSION}:{f['name']}"
        for row in owned_panes(f["name"]):
            if row["session"] == PARK:
                tmux("kill-pane", "-t", row["id"])
        tmux("rename-window", "-t", old, f"{f['name']}-old")
        for row in owned_panes(f["name"]):
            tmux("set-option", "-p", "-u", "-t", row["id"], "@fh_owner")
        open_window(f)
        tmux("kill-window", "-t", f"{SESSION}:{f['name']}-old")
        print(f"{f['name']}: window rebuilt")
    elif cmd == "doctor":
        cmd_doctor()
    elif cmd == "keepawake":
        cmd_keepawake(rest)
    elif cmd == "attach":
        ensure_session()
        os.execvp("tmux", ["tmux", "attach", "-t", SESSION])
    else:
        print(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
