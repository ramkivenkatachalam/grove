#!/usr/bin/env python3
"""grove — Grove's command line: one git worktree, branch, set of ports, dev servers and Claude session
per feature, for any project described by a project config (see `grove project`).

  grove new <name|TICKET-123> [--project P] [--title T] [--parent NAME] [--base REF] [-p PROMPT]
                         worktree on <you>/<name>, its own ports, env rewritten, deps prepared,
                         servers up, Claude briefed (ticket / prompt). A name typed as words
                         becomes a slug ("Main panel tabs" → main-panel-tabs) and the words its title
  grove adopt <worktree>…   register existing worktrees as features (services start stopped)
  grove sessions [--hours H]          recent Claude conversations in the main checkout, not yet in Grove
  grove adopt --session <id>…         bring those conversations into Grove (they resume there)
  grove import [<repo>] [--project P] [--hours H] [--yes|--json]
                         register the repo if new, then list (--yes: adopt) its worktrees and recent
                         Claude conversations that are not in Grove yet
  grove fix-import [--project P] --record JSON | --draft [--json] | --forget KEY | --start [-p BRIEF]
                         what could not come in, and a Claude session briefed to fix it
  grove ls                  features, ports, servers, labels, PR/CI, session state
  grove go <name>           (tmux UI) switch to the feature's window
  grove up|down|restart <name>   start / stop / restart the feature's services
  grove rename <name> <title…>   the display title (worktree, branch and ports keep the name)
  grove pr [--force]        refresh the PR/CI cache (gh), at most every 3 minutes unless forced
  grove findings <name> [--brief] [--mark]   unanswered claude[bot]/Copilot review comments
  grove clean [--yes]       list (or remove) features whose PR merged and whose tree is clean
  grove done <name>         close it: remove servers, sessions, worktree, branch, state (notes and retro archived);
                         asks for --force if it has uncommitted or unmerged work; --keep keeps worktree and branch
  grove migrate             move an older hub to one folder per project and feature (safe to re-run)
  grove doctor              check projects and features: files, deps, ports, env, labels
  grove keepawake [--status|off|on]   keep the Mac awake while any agent is working (Claude
                         sessions start it; it lets go once none are)
  grove retro <name>        draft the feature's retro (what went well, what didn't, what to try next time
                         with an agent) into its retro.md; once, as the feature wraps up
  grove send <name> <text…>  type text into the feature's Claude session (starts it if needed)
  grove recap <name> [--force] [--bg]   a scannable recap of the feature's work (goal, done, now, next,
                         decisions, blockers), written to its recap.json; sessions refresh it after
                         each turn, at most every few minutes; --bg returns at once

  grove project ls                       projects and which one is the default
  grove project add <repo> [--name N]    register a repo (reads its .grove.json, or writes a starter)
  grove project default <name>           the project `grove new` uses outside any project directory
  grove project show <name>              the merged config

  grove host <name>         (app) every pane in its own tmux session; prints JSON
  grove ui [app|tmux]       which front end new features open in
  grove theme [palette]     header palette (claude, plum, teal, wine, forest, slate)
  grove toggle <name> <panel> · grove relayout <name> · grove attach      (tmux UI)

Everything lives under ~/.grove, one folder per project and per feature:

  ~/.grove/projects/<project>/project.json            your config for that project
  ~/.grove/projects/<project>/<feature>/feature.json  the registry entry
                                       /status.json   written by the Claude Code mod
                                       /brief.md      the task, until the agent picks it up
                                       /recap.json    goal, done, now, next… (grove recap)
                                       /notes.md      the Summary tab's scratchpad
                                       /retro.md      grove retro, then yours to edit
                                       /worktree/     the git worktree (a link for features made elsewhere)
"""
from __future__ import annotations

import json
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
HUB = Path(os.environ.get("GROVE_HUB", HOME / ".grove"))
PROJECTS = HUB / "projects"
PRS, FEEDBACK, CONFIG, THEME = HUB / "prs.json", HUB / "feedback.json", HUB / "config.json", HUB / "theme.json"
AWAKE = HUB / "keepawake.pid"
AWAKE_POLL = 30
RECAP_GAP = 180  # seconds between automatic recaps of one feature
RECAP_MODEL = "haiku"
RETRO_MODEL = "sonnet"  # once per feature, so worth the better model
BIN = os.environ.get("GROVE_BIN", str(HUB / "bin/grove"))
SESSION = "features"
PARK = "grove-park"  # tmux UI: a detached session where closed panels keep running
PR_TTL = 180
BOTS = ("claude[bot]", "copilot")
TICKET = re.compile(r"^[A-Za-z][A-Za-z0-9]*-\d+$")

PROJECTS.mkdir(parents=True, exist_ok=True)


def die(msg: str) -> None:
    print(f"grove: {msg}", file=sys.stderr)
    sys.exit(1)


def run(argv, cwd=None, check=False) -> subprocess.CompletedProcess:
    r = subprocess.run(argv, cwd=cwd, text=True, capture_output=True)
    if check and r.returncode:
        die(f"{' '.join(str(a) for a in argv[:3])}…: {r.stderr.strip() or r.stdout.strip()}")
    return r


def read_json(path: Path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def write_json(path: Path, value) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(value, indent=2) + "\n")
    tmp.replace(path)


def expand(path: str) -> Path:
    return Path(os.path.expanduser(path)).resolve()


# ---------- projects ----------
#
# A project config says how to grow a feature from a repo. It is the repo's own `.grove.json`
# (shareable, committed by the team) merged under ~/.grove/projects/<name>/project.json
# (yours: at least {"repo": …}; anything here overrides the repo's file).
#
#   repo          the main checkout                        worktrees  where worktrees go (default: in each
#                                                                     feature's folder under ~/.grove)
#   base          start point for new branches (origin/main)   branchPrefix  "{user}/" by default
#   setup         {"link": [...], "clone": [...], "copy": [...], "run": [...]}, paths relative to the repo:
#                 link = symlink to the main checkout's copy; clone = APFS copy-on-write clone;
#                 copy = copy if missing (env files); run = shell commands in the new worktree
#   services      [{"name", "dir", "run", "ports": [lo, hi], "reserved": [...], "key", "hint", "open"}]
#                 run / hint / open may use {port}, {<service>}, {name}, {path}
#   env           [{"file", "port": {"KEY": "<service>"}, "set": {"KEY": "value with {fe}"}}]:
#                 port = rewrite localhost:NNNN in that line; set = the whole value (added if missing)
#   labels        [{"name", "file", "key", "rules": [[regex, label], ...], "warn": [labels]}]
#   checks        what the agent should run before finishing      agentNotes  extra lines for the agent
#   panels        extra panels: [{"name", "key", "run", "dir"}]

DEFAULT_PROJECT = {
    "base": "origin/main",
    "branchPrefix": "{user}/",
    "setup": {"link": [], "clone": [], "copy": [], "run": []},
    "services": [],
    "env": [],
    "labels": [],
    "checks": "Run the tests and linters that cover what you touched.",
    "agentNotes": "",
    "panels": [],
}


def project_conf(name: str) -> Path:
    return PROJECTS / name / "project.json"


def project_names() -> list[str]:
    return sorted(p.parent.name for p in PROJECTS.glob("*/project.json"))


def project(name: str) -> dict:
    mine = read_json(project_conf(name), None)
    if mine is None:
        die(f"no project '{name}' (grove project ls)")
    repo = expand(mine.get("repo", ""))
    shared = read_json(repo / ".grove.json", {})
    p = {**DEFAULT_PROJECT, **shared, **mine}
    p["setup"] = {**DEFAULT_PROJECT["setup"], **shared.get("setup", {}), **mine.get("setup", {})}
    p["name"], p["repo"] = name, repo
    p["worktrees"] = expand(p["worktrees"]) if p.get("worktrees") else None
    return p


def worktree_for(p: dict, name: str) -> Path:
    """Where a new feature's worktree goes: its own folder in the hub, unless the project says otherwise."""
    return p["worktrees"] / name if p["worktrees"] else PROJECTS / p["name"] / name / "worktree"


def default_project() -> str:
    names = project_names()
    chosen = read_json(CONFIG, {}).get("defaultProject")
    if chosen in names:
        return chosen
    if len(names) == 1:
        return names[0]
    die("no project chosen: grove project add <repo>, or grove new … --project <name>"
        + (f" (projects: {', '.join(names)})" if names else ""))


def project_here() -> str | None:
    cwd = os.getcwd()
    for f in features():
        if cwd == f["path"] or cwd.startswith(f["path"] + "/"):
            return f.get("project")
    for name in project_names():
        repo = str(project(name)["repo"])
        if cwd == repo or cwd.startswith(repo + "/"):
            return name
    return None


def services(p: dict) -> list[dict]:
    return [s for s in p.get("services", []) if s.get("name")]


def handle(p: dict) -> str:
    who = os.environ.get("GROVE_USER")
    if who:
        return who
    email = run(["git", "-C", str(p["repo"]), "config", "user.email"]).stdout.strip()
    return re.sub(r"[^a-zA-Z0-9._-]+", "-", email.split("@")[0]) or os.environ.get("USER", "me")


def fill(text: str, f: dict, port: int | None = None) -> str:
    """{port}, {<service>}, {name}, {path}, {grove} in config strings; anything else is left as written."""
    values = {"name": f["name"], "path": f["path"], "grove": BIN, **{k: str(v) for k, v in ports(f).items()}}
    if port is not None:
        values["port"] = str(port)
    return re.sub(r"\{(\w+)\}", lambda m: values.get(m.group(1), m.group(0)), text)


# ---------- registry ----------

def features() -> list[dict]:
    rows = [read_json(p, None) for p in sorted(PROJECTS.glob("*/*/feature.json"))]
    return [r for r in rows if r]


def registered(name: str) -> Path | None:
    """The feature.json of `name`, in whichever project it is (names are unique across projects)."""
    return next(PROJECTS.glob(f"*/{name}/feature.json"), None)


def feature(name: str) -> dict:
    path = registered(name)
    f = read_json(path, None) if path else None
    if not f:
        die(f"no feature '{name}' (grove ls)")
    return f


def feature_dir(f: dict) -> Path:
    return PROJECTS / (f.get("project") or default_project()) / f["name"]


def save(f: dict) -> None:
    write_json(feature_dir(f) / "feature.json", f)


def status_of(f: dict) -> dict:
    return read_json(feature_dir(f) / "status.json", {})


def ports(f: dict) -> dict[str, int]:
    if "ports" in f:
        return f["ports"]
    return {k: f[v] for k, v in (("fe", "fePort"), ("be", "bePort")) if v in f}  # before projects


def project_of(f: dict) -> dict:
    return project(f.get("project") or default_project())


# ---------- ports & processes ----------

def listening() -> set[int]:
    out = run(["lsof", "-nP", "-iTCP", "-sTCP:LISTEN", "-Fn"]).stdout
    return {int(m) for m in re.findall(r"^n.*:(\d+)$", out, re.M)}


def alloc(service: dict, taken: set[int]) -> int:
    lo, hi = (service.get("ports") or [4000, 4999])[:2]
    for port in range(lo, hi + 1):
        if port not in taken and port not in set(service.get("reserved", [])):
            return port
    die(f"no free port for {service['name']} in {lo}-{hi}; `grove done` a feature first")


def stop_port(port: int) -> None:
    pids = run(["lsof", "-ti", f"tcp:{port}", "-sTCP:LISTEN"]).stdout.split()
    for pid in pids:
        try:
            os.kill(int(pid), signal.SIGTERM)
        except ProcessLookupError:
            pass
    # a --reload supervisor respawns its worker: wait, then force
    for _ in range(12):
        if not run(["lsof", "-ti", f"tcp:{port}", "-sTCP:LISTEN"]).stdout.strip():
            return
        time.sleep(0.5)
    for pid in run(["lsof", "-ti", f"tcp:{port}"]).stdout.split():
        try:
            os.kill(int(pid), signal.SIGKILL)
        except ProcessLookupError:
            pass


# ---------- worktree provisioning ----------

def set_env_key(lines: list[str], key: str, fn) -> bool:
    hit = False
    for i, line in enumerate(lines):
        if line.startswith(f"{key}="):
            lines[i] = fn(line)
            hit = True
    return hit


def provision(p: dict, f: dict) -> None:
    repo, wt = p["repo"], Path(f["path"])
    setup = p["setup"]
    for rel in setup.get("link", []):
        if not (wt / rel).exists() and (repo / rel).exists():
            (wt / rel).parent.mkdir(parents=True, exist_ok=True)
            (wt / rel).symlink_to(repo / rel)
    for rel in setup.get("clone", []):
        if not (wt / rel).exists() and (repo / rel).is_dir():
            print(f"cloning {rel} (copy-on-write)…")
            (wt / rel).parent.mkdir(parents=True, exist_ok=True)
            run(["cp", "-Rc", str(repo / rel), str(wt / rel)], check=True)
    for rel in setup.get("copy", []):
        if not (wt / rel).exists() and (repo / rel).exists():
            (wt / rel).parent.mkdir(parents=True, exist_ok=True)
            (wt / rel).write_bytes((repo / rel).read_bytes())
    for rule in p.get("env", []):
        path = wt / rule["file"]
        if not path.exists():
            continue
        lines = path.read_text().splitlines()
        for key, svc in rule.get("port", {}).items():
            port = ports(f).get(svc)
            if port:
                set_env_key(lines, key, lambda l, port=port: re.sub(r"localhost:\d+", f"localhost:{port}", l))
        for key, value in rule.get("set", {}).items():
            value = fill(value, f)
            if not set_env_key(lines, key, lambda l, value=value, key=key: f"{key}={value}"):
                lines.append(f"{key}={value}")
        path.write_text("\n".join(lines) + "\n")
    for cmd in setup.get("run", []):
        print(f"setup: {cmd}")
        r = subprocess.run(["bash", "-lc", fill(cmd, f)], cwd=wt)
        if r.returncode:
            print(f"grove: setup step failed ({r.returncode}): {cmd}", file=sys.stderr)


def labels(p: dict, f: dict) -> list[tuple[str, str]]:
    """[(name, label)] from the project's label rules: the last uncommented KEY=… line wins."""
    out = []
    for rule in p.get("labels", []):
        try:
            text = (Path(f["path"]) / rule["file"]).read_text()
        except OSError:
            out.append((rule["name"], "?"))
            continue
        values = re.findall(rf"^\s*{re.escape(rule['key'])}\s*=\s*(.*)$", text, re.M)
        if not values:
            out.append((rule["name"], "none"))
            continue
        value = values[-1]
        label = next((lab for rx, lab in rule.get("rules", []) if re.search(rx, value)), None)
        out.append((rule["name"], label or value.split("@")[-1].split("/")[0][:16]))
    return out


# ---------- panes: claude, shell, every service, extra panels ----------

def layout(f: dict) -> list[dict]:
    panes = [{"name": "claude", "run": "{grove} agent {name}", "dir": ""},
             {"name": "shell", "key": "s", "run": "", "dir": "", "focus": True}]
    if f.get("kind") == "session":
        return panes
    p = project_of(f)
    for s in services(p):
        panes.append({"name": s["name"], "key": s.get("key", ""), "run": "{grove} serve " + s["name"] + " {name}",
                      "dir": s.get("dir", ""), "service": True})
    panes += [x for x in p.get("panels", []) if x.get("name")]
    used = set()
    for pane in panes[1:]:  # a unique key per panel: given, else its first free letter
        key = pane.get("key") or next((c for c in pane["name"].lower() if c.isalpha() and c not in used), "")
        pane["key"] = key if key not in used else ""
        used.add(pane["key"])
    return panes


def panels(f: dict) -> list[dict]:
    return [x for x in layout(f) if x["name"] != "claude"]


def pane_cmd(cmd: str) -> str:
    return f"{cmd}; exec $SHELL"


def pane_run(pane: dict, f: dict, servers: bool) -> str:
    if pane.get("service") and not servers:
        return pane_cmd(f"echo '{pane['name']} stopped — grove up {f['name']}'")
    cmd = fill(pane.get("run") or "", f)
    return pane_cmd(cmd) if cmd else ""


def hint(f: dict, pane: str) -> str:
    if pane == "shell":
        return f"worktree {f['path'].replace(str(HOME), '~')}"
    service = next((s for s in services(project_of(f)) if s["name"] == pane), None)
    port = ports(f).get(pane)
    if service and service.get("hint"):
        return fill(service["hint"], f, port)
    return f":{port}" if port else ""


# ---------- tmux ----------

def tmux(*args) -> subprocess.CompletedProcess:
    return run(["tmux", *args])


def ui_mode() -> str:
    """'app' when the Grove app is the front end, else 'tmux' (windows in session `features`)."""
    return read_json(CONFIG, {}).get("ui", "tmux")


DEFAULT_THEME = {
    "_help": "grove theme <name> switches the palette. Text on band is #eeeeee (main) and #bcbcbc "
             "(secondary); pills use black text. Keep every pair >= 4.5:1.",
    "palette": "claude",
    "palettes": {
        "claude": {"band": "#3a2822", "name": "#d77757", "accent": "#e8957a", "waiting": "#ffc2a6", "working": "#b8bccb", "ready": "#8fdcb4"},
        "plum":   {"band": "#3d2350", "name": "#e2c4ff", "accent": "#ff9b7a", "waiting": "#ff9b7a", "working": "#b9bce8", "ready": "#86e0aa"},
        "teal":   {"band": "#123f42", "name": "#9fe6d8", "accent": "#ffa38a", "waiting": "#ffa38a", "working": "#b0c8e6", "ready": "#c2e88f"},
        "wine":   {"band": "#4a1c2c", "name": "#f5cba7", "accent": "#ff9fb0", "waiting": "#ff9fb0", "working": "#cdbdf2", "ready": "#9de3b4"},
        "forest": {"band": "#1d3a2a", "name": "#d4ecb4", "accent": "#ffa585", "waiting": "#ffa585", "working": "#b0c9e8", "ready": "#8fe0c4"},
        "slate":  {"band": "#2a3247", "name": "#c9d3ff", "accent": "#ff9c87", "waiting": "#ff9c87", "working": "#b8bccb", "ready": "#8fdcb4"},
    },
}


def theme() -> dict:
    if not THEME.exists():
        write_json(THEME, DEFAULT_THEME)
    t = read_json(THEME, DEFAULT_THEME)
    pal = dict(DEFAULT_THEME["palettes"]["claude"])
    pal.update((t.get("palettes") or {}).get(t.get("palette", "claude"), {}))
    band = pal["band"].lstrip("#")
    rgb = [int(band[i:i + 2], 16) for i in (0, 2, 4)]
    pal["off"] = "#" + "".join(f"{round(c * 0.86 + 255 * 0.14):02x}" for c in rgb)  # 14% white over band
    return pal


def apply_theme() -> None:
    pal = theme()
    for key in ("band", "name", "accent", "off"):
        tmux("set-option", "-g", f"@grove_c_{key}", pal[key])
    tmux("set-option", "-g", "pane-active-border-style", f"fg={pal['name']}")


def ensure_session() -> None:
    if run(["which", "tmux"]).returncode:
        die("tmux is not installed: brew install tmux")
    apply_theme()
    if ui_mode() == "app":
        return
    if tmux("has-session", "-t", SESSION).returncode:
        names = project_names()
        start = str(project(names[0])["repo"]) if names else str(HOME)
        tmux("new-session", "-d", "-s", SESSION, "-n", "hub", "-c", start)
        tmux("send-keys", "-t", f"{SESSION}:hub", f"{BIN} ls", "C-m")


def has_window(name: str) -> bool:
    if tmux("has-session", "-t", SESSION).returncode:
        return False
    return name in tmux("list-windows", "-t", SESSION, "-F", "#W").stdout.split()


def owned_panes(name: str) -> list[dict]:
    """Every pane of a feature (tmux window, park or app sessions), as {id, pane, window, session}."""
    out = tmux("list-panes", "-a", "-F", "#{pane_id}\t#{@grove_owner}\t#{@grove_pane}\t#{window_id}\t#{session_name}").stdout
    rows = []
    for line in out.splitlines():
        pid, owner, pane, wid, sess = (line.split("\t") + [""] * 5)[:5]
        if owner == name:
            rows.append({"id": pid, "pane": pane, "window": wid, "session": sess})
    return rows


def find_pane(name: str, pane: str) -> str | None:
    return next((r["id"] for r in owned_panes(name) if r["pane"] == pane), None)


def tag(pane_id: str, owner: str, pane: str) -> None:
    tmux("set-option", "-p", "-t", pane_id, "@grove_owner", owner)
    tmux("set-option", "-p", "-t", pane_id, "@grove_pane", pane)


def ensure_park() -> None:
    if tmux("has-session", "-t", PARK).returncode:
        tmux("new-session", "-d", "-s", PARK, "-n", "park", "sleep 2147483647")


def park_new(f: dict, pane: dict, servers: bool) -> str:
    """tmux UI: start a panel closed, in its own window of the park session."""
    ensure_park()
    cmd = pane_run(pane, f, servers)
    r = tmux("new-window", "-d", "-a", "-P", "-F", "#{pane_id}", "-t", f"{PARK}:", "-n", f"{f['name']}_{pane['name']}",
             "-c", str(Path(f["path"]) / pane.get("dir", "")), *([cmd] if cmd else []))
    pid = r.stdout.strip()
    if not pid:
        die(f"could not start panel {pane['name']}: {r.stderr.strip()}")
    tag(pid, f["name"], pane["name"])
    tmux("set-option", "-p", "-t", pid, "@grove_hint", hint(f, pane["name"]))
    return pid


def paint_buttons(f: dict) -> None:
    """tmux UI: the header's panel buttons, ■ open / □ closed, key letter underlined."""
    pal = theme()
    name = f["name"]
    window = f"{SESSION}:{name}"
    open_now = {r["pane"] for r in owned_panes(name) if r["session"] == SESSION}
    parts = []
    for pane in panels(f):
        label, key = pane["name"], pane.get("key", "")
        is_open = label in open_now
        style = f"bg={pal['name']} fg=#000000 bold" if is_open else f"bg={pal['off']} fg=#eeeeee nobold"
        text = label
        if key and key in label:
            i = label.index(key)
            text = f"{label[:i]}#[underscore]{label[i]}#[nounderscore]{label[i + 1:]}"
        parts.append(f"#[range=user|tog:{label[:11]}]#[{style}] {'■' if is_open else '□'} {text} #[norange bg={pal['band']} nobold] ")
    parts.append("#[fg=#bcbcbc]^b P+key ")
    tmux("set-option", "-w", "-t", window, "@grove_buttons", "".join(parts))
    count = len([r for r in owned_panes(name) if r["session"] == SESSION])
    tmux("set-option", "-w", "-t", window, "pane-border-status", "top" if count > 1 else "off")


def bind_panel_keys(f: dict) -> None:
    tmux("bind-key", "P", "switch-client", "-T", "grovepanel")
    for pane in panels(f):
        if pane.get("key"):
            tmux("bind-key", "-T", "grovepanel", pane["key"], "run-shell", "-b",
                 f"{BIN} toggle '#{{window_name}}' {pane['name']}")


def host_session(name: str, pane: str) -> str:
    return "grove_" + re.sub(r"[^A-Za-z0-9_-]", "_", name) + "_" + pane


def host(f: dict, servers: bool = True) -> list[dict]:
    """App mode: every pane of the feature in its own detached tmux session (status off), which the
    app attaches a terminal to. Idempotent; panes from the tmux UI are moved over, still running."""
    name = f["name"]
    out = []
    rows = owned_panes(name)
    for pane in layout(f):
        sess = host_session(name, pane["name"])
        cwd = str(Path(f["path"]) / pane.get("dir", ""))
        if tmux("has-session", "-t", f"={sess}").returncode:
            existing = next((r for r in rows if r["pane"] == pane["name"] and not r["session"].startswith("grove_")), None)
            if existing:
                tmux("new-session", "-d", "-s", sess, "-c", cwd, "sleep 2147483647")
                tmux("move-pane", "-s", existing["id"], "-t", f"={sess}:")
                tmux("kill-pane", "-a", "-t", existing["id"])
            else:
                cmd = pane_run(pane, f, servers)
                r = tmux("new-session", "-d", "-P", "-F", "#{pane_id}", "-s", sess, "-c", cwd, *([cmd] if cmd else []))
                if r.returncode:
                    die(f"could not start {sess}: {r.stderr.strip()}")
                pid = r.stdout.strip()
                tag(pid, name, pane["name"])
                tmux("set-option", "-p", "-t", pid, "@grove_hint", hint(f, pane["name"]))
        tmux("set-option", "-t", f"={sess}:", "status", "off")
        tmux("set-option", "-t", f"={sess}:", "@grove_app", "1")
        if pane["name"] != "claude":
            out.append({"pane": pane["name"], "session": sess, "hint": hint(f, pane["name"]), "key": pane.get("key", "")})
        else:
            out.insert(0, {"pane": "claude", "session": sess, "hint": "", "key": ""})
    if has_window(name) and not [r for r in owned_panes(name) if r["session"] == SESSION]:
        tmux("kill-window", "-t", f"{SESSION}:{name}")
    return out


def open_window(f: dict, servers: bool = True) -> None:
    if ui_mode() == "app":
        host(f, servers)
        return
    ensure_session()
    name, wt = f["name"], f["path"]
    if has_window(name):
        return
    claude = layout(f)[0]
    r = tmux("new-window", "-d", "-P", "-F", "#{pane_id}", "-t", SESSION, "-n", name, "-c", wt, pane_run(claude, f, servers))
    claude_id = r.stdout.strip()
    if not claude_id:
        die(f"could not open window {name}: {r.stderr.strip()}")
    tag(claude_id, name, "claude")
    target = f"{SESSION}:{name}"
    tmux("set-option", "-w", "-t", target, "@grove_feature", name)
    tmux("set-option", "-w", "-t", target, "@grove_path", wt)
    have = {x["pane"] for x in owned_panes(name)}
    for pane in panels(f):
        if pane["name"] not in have:
            park_new(f, pane, servers)
    bind_panel_keys(f)
    paint_buttons(f)


def toggle(f: dict, panel: str, focus: bool | None = None) -> None:
    name = f["name"]
    pane = next((x for x in panels(f) if x["name"] == panel), None)
    if pane is None:
        die(f"no panel '{panel}' (panels: {', '.join(x['name'] for x in panels(f))})")
    rows = owned_panes(name)
    mine = next((x for x in rows if x["pane"] == panel), None)
    if mine is None:
        park_new(f, pane, servers=True)
        mine = next(x for x in owned_panes(name) if x["pane"] == panel)
    if mine["session"] == SESSION:
        ensure_park()
        r = tmux("break-pane", "-d", "-a", "-s", mine["id"], "-t", f"{PARK}:", "-n", f"{name}_{panel}")
        if r.returncode:
            die(f"could not close {panel}: {r.stderr.strip()}")
    else:
        open_rows = [x for x in rows if x["session"] == SESSION and x["pane"] != "claude"]
        claude = next((x for x in rows if x["session"] == SESSION and x["pane"] == "claude"), None)
        target = open_rows[-1]["id"] if open_rows else (claude["id"] if claude else f"{SESSION}:{name}.0")
        split = ["-v"] if open_rows else ["-h", "-l", "40%"]
        should_focus = pane.get("focus", False) if focus is None else focus
        tmux("join-pane", *([] if should_focus else ["-d"]), *split, "-s", mine["id"], "-t", target)
    paint_buttons(f)


def switch_to(name: str) -> None:
    target = f"{SESSION}:{name}"
    if os.environ.get("TMUX"):
        if tmux("switch-client", "-t", target).returncode:
            tmux("select-window", "-t", target)
    else:
        tmux("select-window", "-t", target)
        if not sys.stdout.isatty():
            print(f"{name} selected — run `grove attach` in a terminal to see it")
            return
        os.execvp("tmux", ["tmux", "attach", "-t", SESSION])


# ---------- PRs ----------

def ci_state(rollup: list) -> str:
    states = [(c.get("conclusion") or c.get("state") or c.get("status") or "").upper() for c in rollup or []]
    if not states:
        return "none"
    if any(s in ("FAILURE", "ERROR", "TIMED_OUT", "ACTION_REQUIRED", "STARTUP_FAILURE") for s in states):
        return "fail"
    if any(s in ("IN_PROGRESS", "QUEUED", "PENDING", "WAITING", "EXPECTED", "") for s in states):
        return "running"
    return "pass"


def pr_sync(force: bool = False) -> dict:
    cache = read_json(PRS, {})
    if not force and time.time() - cache.get("fetchedAt", 0) < PR_TTL:
        return cache
    by_branch: dict = {}
    wanted = {f.get("project") or default_project() for f in features()} if features() else set()
    for name in wanted:
        p = project(name)
        if p.get("prs") is False:
            continue
        r = run(["gh", "pr", "list", "--author", "@me", "--state", "all", "--limit", "60", "--json",
                 "number,headRefName,state,isDraft,url,statusCheckRollup,reviewDecision,updatedAt"], cwd=p["repo"])
        if r.returncode:
            continue
        for pr in json.loads(r.stdout):
            b = pr["headRefName"]
            if b in by_branch and by_branch[b]["state"] == "OPEN":
                continue  # keep the open PR over an older closed one
            by_branch[b] = {"number": pr["number"], "state": pr["state"], "isDraft": pr["isDraft"],
                            "url": pr["url"], "ci": ci_state(pr["statusCheckRollup"]), "project": name,
                            "review": pr.get("reviewDecision") or "", "updatedAt": pr["updatedAt"]}
    for f in features():
        pr = by_branch.get(f["branch"])
        if pr and pr["state"] == "OPEN":
            pr["findings"] = len(new_findings(project_of(f), pr["number"], pr["updatedAt"]))
    cache = {"fetchedAt": time.time(), "byBranch": by_branch}
    write_json(PRS, cache)
    return cache


def pr_for(f: dict) -> dict | None:
    if f.get("kind") == "session":
        return None
    return read_json(PRS, {}).get("byBranch", {}).get(f["branch"])


def bot_comments(p: dict, number: int) -> list[dict]:
    r = run(["gh", "api", f"repos/:owner/:repo/pulls/{number}/comments", "--paginate", "--jq", ".[]"], cwd=p["repo"])
    rows = [json.loads(line) for line in r.stdout.splitlines() if line.strip()]
    return [c for c in rows if any(b in (c.get("user") or {}).get("login", "").lower() for b in BOTS)
            and not c.get("in_reply_to_id")]


def new_findings(p: dict, number: int, updated_at: str, refresh: bool = False, mark: bool = False) -> list[dict]:
    fb = read_json(FEEDBACK, {})
    key = f"{p['name']}#{number}"
    seen = fb.get(key, fb.get(str(number)))
    if seen is not None and seen.get("updatedAt") == updated_at and not (refresh or mark):
        return list(seen.get("pending", []))
    comments = bot_comments(p, number)
    handled = set(seen["handled"]) if seen else {c["id"] for c in comments}  # first sighting: record only
    pending = [c for c in comments if c["id"] not in handled]
    slim = [{"id": c["id"], "path": c.get("path"), "line": c.get("line") or c.get("original_line"),
             "url": c.get("html_url"), "body": c.get("body", "")[:600]} for c in pending]
    if mark:
        handled |= {c["id"] for c in pending}
        slim = []
    fb[key] = {"handled": sorted(handled), "pending": slim, "updatedAt": updated_at}
    fb.pop(str(number), None)
    write_json(FEEDBACK, fb)
    return slim


def severity(body: str) -> str:
    if "🔴" in body or re.search(r"\bcritical\b", body, re.I):
        return "critical"
    if "🔵" in body:
        return "suggestion"
    return "important"


